# dArkOS base release (upstream tag)
DARKOS_RELEASE="v08272026"

# Upstream G350 split archive basename (without .7z.001 suffix)
BASE_IMAGE_BASENAME="dArkOS_G350_trixie_09022026"

# GitHub release download URL prefix
DARKOS_DOWNLOAD_BASE="https://github.com/christianhaitian/dArkOS/releases/download/${DARKOS_RELEASE}"

# Mod branding for output filenames
MOD_PREFIX="ADeUX_"
MOD_SUFFIX="trixie_09022026"

# G350 boot FAT partition number on GPT layout
BOOT_PART=1
ROOTFS_PART=2

# Upstream G350 dtb on boot partition (removed during mod)
UPSTREAM_DTB="rk3326-g350-linux.dtb"

# Asset paths (relative to repo root)
KERNEL_IMAGE="Image"

# Device variants to build (name:dtb_filename)
# All console-dir variants -- DTB and boot.ini are read from
# consoles/<NAME>/ (see scripts/lib-variants.sh).
# TODO: confirm each console's actual DTB filename below.
MOD_VARIANTS=(
  "R36S:rk3326-r36s.dtb"
  "R36SPlus:rk3326-r36splus.dtb::R36S Plus"
  "R45H:rk3326-r45h.dtb:R42Pro_R45H_R46H:R42 Pro / R45H / R46H"
)

# 7z split volume size (stay under GitHub Release 2GiB per-asset limit)
SPLIT_SIZE="1900m"